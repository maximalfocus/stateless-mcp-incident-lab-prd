kind: service
repos: stateless-mcp-incident-lab-typescript-sdk
base_url: http://127.0.0.1:3102/sdk/mcp
up: docker compose -f stateless-mcp-incident-lab-prd/demo/sdk.compose.yaml up -d --wait
teardown: docker compose -f stateless-mcp-incident-lab-prd/demo/sdk.compose.yaml down -v
deploy: stateless-mcp-incident-lab-infrastructure
